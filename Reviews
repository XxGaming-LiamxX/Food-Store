<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Customer Reviews - FreshMart Grocery Store</title>
<!-- If your site already has a stylesheet, delete this <style> block and link it instead:
     <link rel="stylesheet" href="style.css"> -->
<style>
:root{--brand:#2e7d32;--brand-dark:#1b5e20;--bg:#f4f4f4;--card:#fff;--text:#222;--muted:#666;--star:#f5a623}
*{box-sizing:border-box}
body{margin:0;font-family:Arial,Helvetica,sans-serif;background:var(--bg);color:var(--text)}
header{background:var(--brand);color:#fff;text-align:center;padding:24px 16px 12px}
header h1{margin:0 0 4px}
header p{margin:0 0 12px}
nav a{color:#fff;text-decoration:none;margin:0 12px;font-weight:bold;padding-bottom:3px}
nav a:hover,nav a.active{border-bottom:2px solid #fff}
main{max-width:900px;margin:0 auto;padding:24px 16px}
h2{margin-top:0}
.summary{background:var(--card);border-radius:8px;padding:20px;box-shadow:0 2px 6px rgba(0,0,0,.1);display:flex;gap:24px;align-items:center;flex-wrap:wrap}
.avg{font-size:3rem;font-weight:bold;color:var(--brand)}
.stars{color:var(--star);letter-spacing:2px}
.muted{color:var(--muted);font-size:.9rem}
.bars{flex:1;min-width:220px}
.bar{display:flex;align-items:center;gap:8px;font-size:.9rem;margin:3px 0}
.track{flex:1;height:10px;background:#ddd;border-radius:5px;overflow:hidden}
.fill{height:100%;background:var(--brand)}
.tools{display:flex;gap:12px;flex-wrap:wrap;margin:20px 0}
select,input,textarea{font:inherit;padding:8px;border:1px solid #ccc;border-radius:5px;background:#fff}
button{background:var(--brand);color:#fff;border:0;padding:9px 16px;border-radius:5px;cursor:pointer;font:inherit}
button:hover{background:var(--brand-dark)}
button.light{background:#eee;color:var(--text);padding:5px 12px;font-size:.85rem}
button.light:hover{background:#ddd}
.review{background:var(--card);border-radius:8px;padding:16px;margin-bottom:14px;box-shadow:0 2px 6px rgba(0,0,0,.1)}
.review h3{margin:4px 0}
.review p{margin:8px 0}
.badge{background:#e8f5e9;color:var(--brand-dark);font-size:.75rem;padding:2px 8px;border-radius:10px;margin-left:6px}
.form{background:var(--card);border-radius:8px;padding:20px;box-shadow:0 2px 6px rgba(0,0,0,.1);margin-top:28px}
.form label{display:block;margin:12px 0 4px;font-weight:bold}
.form input,.form textarea,.form select{width:100%}
.pick button{background:none;color:#ccc;font-size:1.8rem;padding:0 3px}
.pick button.on{color:var(--star)}
#msg{margin-top:10px;font-weight:bold}
footer{text-align:center;padding:20px;color:var(--muted);font-size:.9rem}
</style>
</head>
<body>
<header>
  <h1>FreshMart Grocery Store</h1>
  <p>Your daily fresh food delivered</p>
  <nav>
    <a href="index.html">Home</a>
    <a href="reviews.html" class="active">Reviews</a>
    <a href="contact.html">Contact</a>
  </nav>
</header>

<main>
  <h2>Customer Reviews</h2>
  <section class="summary">
    <div><div class="avg" id="avg"></div><div class="stars" id="avgStars"></div><div class="muted" id="count"></div></div>
    <div class="bars" id="bars"></div>
  </section>

  <div class="tools">
    <select id="prodFilter" aria-label="Filter by product"></select>
    <select id="sort" aria-label="Sort reviews">
      <option value="new">Newest</option><option value="high">Highest rated</option><option value="low">Lowest rated</option><option value="help">Most helpful</option>
    </select>
  </div>

  <div id="list"></div>

  <section class="form">
    <h2>Write a Review</h2>
    <label for="name">Your Name</label><input id="name" maxlength="40">
    <label for="prod">Product</label><select id="prod"></select>
    <label>Rating</label><div class="pick" id="pick"></div>
    <label for="title">Headline</label><input id="title" maxlength="70">
    <label for="body">Your Review</label><textarea id="body" rows="4" maxlength="600"></textarea>
    <button id="submit" style="margin-top:14px">Submit Review</button>
    <div id="msg" role="status"></div>
  </section>
</main>

<footer>FreshMart Grocery Store &copy; 2026</footer>

<script>
const products=["Fresh Apples","Bananas","Full Cream Milk","Wholegrain Bread","Free Range Eggs","Chicken Breast"];
const reviews=[
{n:"Maya R.",p:"Fresh Apples",r:5,t:"Crisp and sweet",b:"Best apples I've had delivered. Not a single bruise in the bag.",d:"2026-09-28",h:12},
{n:"Daniel K.",p:"Free Range Eggs",r:5,t:"Deep orange yolks",b:"You can taste the difference. Packed carefully, nothing cracked.",d:"2026-09-22",h:18},
{n:"Priya S.",p:"Wholegrain Bread",r:4,t:"Great loaf, goes stale fast",b:"Soft and seedy, fantastic toasted. Eat it within two days.",d:"2026-09-14",h:7},
{n:"Tom W.",p:"Chicken Breast",r:5,t:"Good quality and trimmed well",b:"Plenty of meat, very little fat. Arrived properly chilled.",d:"2026-09-05",h:9},
{n:"Lena B.",p:"Bananas",r:3,t:"A bit green on arrival",b:"Tasty once ripe, but I'd have liked them a day or two riper.",d:"2026-08-20",h:5},
{n:"Sam O.",p:"Full Cream Milk",r:4,t:"Fresh with a long date",b:"Tastes fresh and the use-by was a week out.",d:"2026-08-09",h:3}
];
const $=id=>document.getElementById(id);
let rating=0;
const stars=n=>"★".repeat(n)+"☆".repeat(5-n);
const esc=s=>s.replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const fmt=d=>new Date(d+"T00:00:00").toLocaleDateString("en-AU",{day:"numeric",month:"short",year:"numeric"});
$("prodFilter").innerHTML='<option value="">All products</option>'+products.map(p=>`<option>${p}</option>`).join("");
$("prod").innerHTML=products.map(p=>`<option>${p}</option>`).join("");
$("pick").innerHTML=[1,2,3,4,5].map(i=>`<button type="button" aria-label="${i} star" data-v="${i}">★</button>`).join("");

function summary(){
  const c=[0,0,0,0,0,0];reviews.forEach(x=>c[x.r]++);
  const avg=reviews.reduce((a,x)=>a+x.r,0)/reviews.length;
  $("avg").textContent=avg.toFixed(1);$("avgStars").textContent=stars(Math.round(avg));
  $("count").textContent="Based on "+reviews.length+" reviews";
  $("bars").innerHTML=[5,4,3,2,1].map(s=>`<div class="bar"><span>${s} star</span><span class="track"><span class="fill" style="display:block;width:${c[s]/reviews.length*100}%"></span></span><span>${c[s]}</span></div>`).join("");
}
function list(){
  const f=$("prodFilter").value,s=$("sort").value;
  const a=reviews.filter(x=>!f||x.p===f);
  a.sort((x,y)=>s==="high"?y.r-x.r:s==="low"?x.r-y.r:s==="help"?y.h-x.h:y.d.localeCompare(x.d));
  $("list").innerHTML=a.length?a.map(x=>`<article class="review"><div class="stars" aria-label="${x.r} out of 5">${stars(x.r)}</div><h3>${esc(x.t)}</h3><div class="muted">${esc(x.n)}<span class="badge">Verified buyer</span> &middot; ${fmt(x.d)} &middot; ${esc(x.p)}</div><p>${esc(x.b)}</p><button class="light" data-i="${reviews.indexOf(x)}">Helpful (${x.h})</button></article>`).join(""):'<p class="muted">No reviews for this product yet. Be the first to write one below.</p>';
}
$("prodFilter").onchange=list;$("sort").onchange=list;
$("list").onclick=e=>{const b=e.target.closest("button");if(b){reviews[b.dataset.i].h++;list()}};
$("pick").onclick=e=>{const b=e.target.closest("button");if(!b)return;rating=+b.dataset.v;[...$("pick").children].forEach((k,i)=>k.classList.toggle("on",i<rating))};
$("submit").onclick=()=>{
  const n=$("name").value.trim(),t=$("title").value.trim(),b=$("body").value.trim();
  if(!n||!rating||!t||!b){$("msg").style.color="#b71c1c";$("msg").textContent="Please add your name, a star rating, a headline and your review.";return}
  reviews.push({n,p:$("prod").value,r:rating,t,b,d:new Date().toISOString().slice(0,10),h:0});
  ["name","title","body"].forEach(i=>$(i).value="");rating=0;[...$("pick").children].forEach(k=>k.classList.remove("on"));
  $("msg").style.color="#2e7d32";$("msg").textContent="Thanks! Your review has been added.";
  $("prodFilter").value="";$("sort").value="new";summary();list();
<a href="reviews.html">Reviews</a>
};
summary();list();
</script>
</body>
</html>
